# Copy to .env (git-ignored). In production these come from a secret manager instead.
# Better for secrets on your own machine: leave them blank here and store them in the
# OS credential store:  python -m keyring set ask-the-pipeline LLM_API_KEY

# Any OpenAI-compatible endpoint: OpenRouter (default), Ollama, OpenAI, Z.AI...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.3-flash
LLM_API_KEY=
# Local and free instead:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:8b  (no key)

# Slack (only for the bot): see slack/manifest.yml
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional: where the serving database lives
# AGENT_DB=.cache/agent.duckdb
